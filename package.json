    "start": "vercel dev",
    "test": "node --test"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "bcryptjs": "^3.0.2"
  },
  "devDependencies": {
    "vercel": "^48.1.0"
  }
}

{
  "name": "seedling",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "env:pull": "vercel env pull .env.local",
    "db:migrate": "npm run env:pull && node --env-file=.env.local scripts/migrate.js",
